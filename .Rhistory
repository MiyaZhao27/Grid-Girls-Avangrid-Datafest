p4 <- ggplot(daily, aes(date, approx_customers)) +
geom_line() +
labs(title = "Approx. customers reporting per day", x = NULL, y = "Customers") +
theme_minimal()
p1; p2; p3; p4
library(dplyr)
library(tidyr)
library(ggplot2)
weather_daily <- weather |>
mutate(
date      = as.Date(date, format = "%d/%m/%Y"),
temp      = as.numeric(temp),
humidity  = as.numeric(humidity),
windspeed = as.numeric(windspeed)
) |>
group_by(date) |>
summarise(
avg_temp      = mean(temp, na.rm = TRUE),
avg_humidity  = mean(humidity, na.rm = TRUE),
max_windspeed = max(windspeed, na.rm = TRUE),
.groups = "drop"
)
daily_weather <- daily |>
left_join(weather_daily, by = "date")
k <- max(daily_weather$approx_customers, na.rm = TRUE) / 100
p4_overlay <- ggplot(daily_weather, aes(x = date)) +
geom_line(aes(y = avg_temp * k, color = "Avg Temp (°F)"), alpha = 0.7) +
geom_line(aes(y = avg_humidity * k, color = "Avg Humidity (%)"), alpha = 0.7) +
geom_line(aes(y = max_windspeed * k, color = "Max Windspeed (mph)"), alpha = 0.85) +
geom_line(aes(y = approx_customers, color = "Approx. Customers"), linewidth = 1) +
scale_y_continuous(
name = "Approx. Customers Reporting",
labels = scales::comma,
sec.axis = sec_axis(~ . / k, name = "Temp (°F) / Humidity (%) / Windspeed (mph)")
) +
scale_color_manual(
name = NULL,
values = c(
"Approx. Customers"   = "black",
"Avg Temp (°F)"       = "tomato",
"Avg Humidity (%)"    = "steelblue",
"Max Windspeed (mph)" = "darkorchid"
)
) +
labs(
title = "Customer Reporting Coverage vs. Daily Weather",
subtitle = "Reporting drops aligned with wind/humidity spikes indicate storm-related outages",
x = NULL
) +
theme_minimal() +
theme(legend.position = "bottom")
p4_overlay
p4_stacked <- daily_weather |>
select(date, approx_customers, max_windspeed, avg_humidity, avg_temp) |>
pivot_longer(-date, names_to = "metric", values_to = "value") |>
mutate(metric = factor(
metric,
levels = c("approx_customers", "max_windspeed", "avg_humidity", "avg_temp"),
labels = c("Approx. Customers", "Max Windspeed (mph)", "Avg Humidity (%)", "Avg Temp (°F)")
)) |>
ggplot(aes(x = date, y = value, color = metric)) +
geom_line(show.legend = FALSE) +
facet_wrap(~ metric, ncol = 1, scales = "free_y") +
labs(title = "Customer Reporting & Weather Diagnostics", x = NULL, y = NULL) +
theme_minimal()
p4_stacked
library(dplyr)
library(tidyr)
library(ggplot2)
# Helper: 15-day centered rolling median (handles NAs safely in base R)
roll_med <- function(x, half_win = 7) {
n <- length(x)
sapply(seq_len(n), function(i) {
idx <- max(1, i - half_win):min(n, i + half_win)
median(x[idx], na.rm = TRUE)
})
}
# 1. Compute deviations from each metric's local 15-day baseline
daily_dev <- daily_weather |>
arrange(date) |>
mutate(
cust_base = roll_med(approx_customers),
wind_base = roll_med(max_windspeed),
hum_base  = roll_med(avg_humidity),
temp_base = roll_med(avg_temp),
# Anomalies relative to surrounding 2 weeks
cust_pct_dev = (approx_customers - cust_base) / cust_base * 100,
wind_dev     = max_windspeed - wind_base,
hum_dev      = avg_humidity - hum_base,
temp_dev     = avg_temp - temp_base,
# Flag days where customer reporting dips > 1% below baseline
is_dip = cust_pct_dev < -1
)
dip_dates <- daily_dev |> filter(is_dip)
# 2. Stacked deviation plot with vertical lines marking every customer dip
p_dev <- daily_dev |>
select(date, cust_pct_dev, wind_dev, hum_dev, temp_dev) |>
pivot_longer(-date, names_to = "metric", values_to = "deviation") |>
mutate(metric = factor(
metric,
levels = c("cust_pct_dev", "wind_dev", "hum_dev", "temp_dev"),
labels = c(
"Customer Reporting Dev (%)",
"Max Windspeed Dev (mph)",
"Avg Humidity Dev (% pts)",
"Avg Temp Dev (°F)"
)
)) |>
ggplot(aes(x = date, y = deviation)) +
geom_hline(yintercept = 0, linetype = "dotted", color = "gray50") +
geom_vline(
data = dip_dates,
aes(xintercept = date),
linetype = "dashed",
color = "firebrick",
alpha = 0.65
) +
geom_line(aes(color = metric), show.legend = FALSE) +
facet_wrap(~ metric, ncol = 1, scales = "free_y") +
labs(
title = "Customer Reporting Dips vs. Weather Deviations (15-Day Rolling Baseline)",
subtitle = "Red dashed lines mark customer reporting drops > 1% below local baseline",
x = NULL,
y = "Deviation from Baseline"
) +
theme_minimal()
p_dev
# 3. Print exact dates and weather anomalies for every customer dip
dip_dates |>
select(
date,
approx_customers,
cust_pct_dev,
max_windspeed,
wind_dev,
avg_humidity,
hum_dev,
avg_temp,
temp_dev
) |>
mutate(across(where(is.numeric), ~ round(.x, 1))) |>
print(n = 30)
